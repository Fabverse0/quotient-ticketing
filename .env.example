# Salin ke .env lalu sesuaikan. Divalidasi saat startup oleh api/src/shared/config.ts.

NODE_ENV=development
PORT=3000

# Port host 5433 sesuai docker-compose.yml (5432 sering dipakai Postgres lokal).
DATABASE_URL=postgres://quotient:quotient@localhost:5433/quotient
DB_POOL_MAX=10
# Batas tunggu (ms) koneksi bebas dari pool dan tunggu lock baris/advisory. Lewat batas: 503 DATABASE_BUSY.
DB_CONNECTION_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=5000

# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Format: angka + satuan s/m/h/d, misalnya 30m, 1h, 7d.
JWT_EXPIRES_IN=1h

# atomic (default, aman) atau naive (sengaja rentan oversell, hanya untuk demo pembanding).
QUOTA_STRATEGY=atomic

# Kunci HMAC-SHA256 untuk memverifikasi header X-Signature di POST /webhooks/payment.
# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=ganti-dengan-secret-webhook-minimal-32-karakter

# Sweeper mengubah pesanan PENDING yang lewat waktu tahan menjadi EXPIRED dan mengembalikan kuotanya.
# SWEEPER_ENABLED: true atau false. SWEEPER_INTERVAL_MS: jeda antar putaran, minimal 1000.
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_MS=30000

# Akun organizer dibuat dari sini saat API start (idempotent). Isi keduanya atau kosongkan keduanya.
ORGANIZER_EMAIL=organizer@quotient.local
ORGANIZER_PASSWORD=ganti-password-organizer

# Dipakai docker-compose.yml. Di dalam compose, API memakai host "postgres" dan port 5432,
# nilai DATABASE_URL di atas hanya untuk menjalankan API langsung di host.
API_PORT=3000
POSTGRES_USER=quotient
POSTGRES_PASSWORD=quotient
POSTGRES_DB=quotient
POSTGRES_PORT=5433
