# Salin ke .env lalu sesuaikan. Divalidasi saat startup oleh api/src/shared/config.ts.

NODE_ENV=development
PORT=3000

# Port host 5433 sesuai docker-compose.yml (5432 sering dipakai Postgres lokal).
DATABASE_URL=postgres://quotient:quotient@localhost:5433/quotient
DB_POOL_MAX=10

# Dipakai docker-compose.yml. Di dalam compose, API memakai host "postgres" dan port 5432,
# nilai DATABASE_URL di atas hanya untuk menjalankan API langsung di host.
API_PORT=3000
POSTGRES_USER=quotient
POSTGRES_PASSWORD=quotient
POSTGRES_DB=quotient
POSTGRES_PORT=5433
